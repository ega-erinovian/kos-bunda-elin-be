# App
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kost_bunda_elin?schema=public

# Auth
ACCESS_TOKEN_SECRET=change-me-access-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Default Property (isi setelah seed jalan)
DEFAULT_PROPERTY_ID=

# Seed
SEED_ADMIN_EMAIL=admin@kosbundaelin.test
SEED_ADMIN_PASSWORD=ChangeMe123!

# Web Push (VAPID) - generate pakai `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@kosbundaelin.test

# Cron
REMINDER_CRON_SCHEDULE=0 8 * * *
TZ=Asia/Jakarta

# WhatsApp (Phase 8–10) — required in production, optional in development/test
# WHATSAPP_PROVIDER: cloud = Meta Cloud API (pay per template), evolution = self-hosted
# Evolution API, free via own number (unofficial, ban risk if spamming), mock = no network (CI/dev)
WHATSAPP_PROVIDER=cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_MAX_RETRY=3

# Evolution API (only when WHATSAPP_PROVIDER=evolution) — self-hosted, e.g. docker run evolution-api
# See https://github.com/evolution-foundation/evolution-api
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=

# Notification retry (Phase 10)
NOTIFICATION_RETRY_CRON_SCHEDULE=*/15 * * * *

# Reports
REPORTS_MAX_RANGE_DAYS=1100
