# App
NODE_ENV=test
LOG_LEVEL=silent

# Database (test database, dibuat otomatis oleh global-setup)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kost_bunda_elin_test?schema=public

# Auth
ACCESS_TOKEN_SECRET=test-access-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
ACCESS_COOKIE_NAME=access_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false

# Default Property (id yang di-upsert oleh prisma/seed.ts)
DEFAULT_PROPERTY_ID=default-property

# Seed
SEED_ADMIN_EMAIL=admin@kosbundaelin.test
SEED_ADMIN_PASSWORD=ChangeMe123!
